# Groq is the primary AI extraction provider. Keep this key server-side only.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Local development defaults. On Render, set FP_DB_URL and FP_UPLOAD_DIR to the persistent disk.
FP_DB_URL=sqlite:///./flowpilot.db
FP_UPLOAD_DIR=./backend/uploads
FP_MAX_MB=10
FP_MAX_PAGES=20
FP_COOKIE_SECURE=false
# Optional overrides:
# FP_FRONTEND_DIR=./frontend
# DATABASE_URL=postgresql://user:password@host:5432/dbname
